{
  "schemaVersion": 1,
  "id": "autoattack",
  "version": "${mod_version}",

  "name": "Auto Attack",
  "description": "Hold down the attack button and your character will keep swinging automatically, timed to the attack cooldown — no need to click repeatedly.",
  "authors": [
    "Vin35"
  ],
  "contributors": [
    "Tfarecnim",
    "BlazingTwist",
    "Rongmario",
    "Warabin"
  ],
  "contact": {
    "homepage": "https://github.com/warabin55/AutoAttack",
    "sources": "https://github.com/warabin55/AutoAttack",
    "issues": "https://github.com/warabin55/AutoAttack/issues"
  },

  "license": "MIT",
  "icon": "assets/autoattack/icon.png",

  "environment": "client",
  "entrypoints": {
    "main": [
      "vin35.autoattack.Main"
    ],
    "client": [
      "vin35.autoattack.AutoAttack",
      "vin35.autoattack.config.KeyBindingConfig"
    ]
  },
  "mixins": [
    {
      "config": "autoattack.client.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "midnightlib": "*",
    "minecraft": "~26.1",
    "java": ">=25"
  }
}
